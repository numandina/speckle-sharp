<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <AssemblyName>CloudFabRevitInstaller</AssemblyName>
    <RootNamespace>CloudFabRevitInstaller</RootNamespace>
    <!-- Single-version mode: build script passes -p:RevitVersion=2025 -->
    <!-- Multi-version mode: no RevitVersion needed (installer auto-detects version dirs) -->
    <RevitVersion Condition="'$(RevitVersion)' == ''"></RevitVersion>
    <!-- Exclude from solution-wide builds and kit folder copies -->
    <CopyToKitFolder>false</CopyToKitFolder>
    <IsDesktopBuild>false</IsDesktopBuild>
  </PropertyGroup>
  <ItemGroup Condition="'$(RevitVersion)' != ''">
    <AssemblyMetadata Include="RevitVersion" Value="$(RevitVersion)" />
  </ItemGroup>
</Project>
